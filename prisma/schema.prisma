// Hestia data model.
// Tenancy rule: every tenant-owned table carries workspaceId. All reads and
// writes MUST filter by the workspaceId obtained from requireWorkspace()
// (src/lib/tenant.ts), never by a client-supplied id alone.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------- Auth ----

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  // Bumped on password change/reset; a JWT carrying an older value is rejected.
  sessionVersion Int      @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts        Account[]
  sessions        Session[]
  memberships     Membership[]
  invitationsSent Invitation[]  @relation("InvitationInviter")
  posts           Post[]
  comments        Comment[]
  todoListsMade   TodoList[]
  todosCreated    TodoItem[]    @relation("TodoCreator")
  todosAssigned   TodoItem[]    @relation("TodoAssignee")
  todoAssignments TodoAssignee[]
  cardsCreated    Card[]        @relation("CardCreator")
  projectsCreated Project[]     @relation("ProjectCreator")
  cardsAssigned   Card[]        @relation("CardAssignee")
  foldersCreated  Folder[]
  filesUploaded   File[]
  fileVersionsUploaded FileVersion[]
  documents       Document[]
  eventsCreated   Event[]
  eventInvites    EventInvitee[]
  chatMessages    ChatMessage[] @relation("ChatAuthor")
  chatReceived    ChatMessage[] @relation("ChatRecipient")
  notifications      Notification[] @relation("NotificationRecipient")
  notificationsActed Notification[] @relation("NotificationActor")
  authTokens         AuthToken[]
  activities         Activity[]
  subscriptions      Subscription[]
  reactions          Reaction[]
  bookmarks          Bookmark[]
  notificationPreferences NotificationPreference[]
  checkinQuestions CheckinQuestion[]
  checkinAnswers   CheckinAnswer[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------------------------------------- Tenancy ----

enum Role {
  OWNER
  ADMIN
  MEMBER
  // Client / guest: sees only items that are not marked internal ("Yalnızca ekip").
  GUEST
}

model Workspace {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  invitations  Invitation[]
  posts        Post[]
  messageCategories MessageCategory[]
  comments     Comment[]
  todoLists    TodoList[]
  todoItems    TodoItem[]
  todoSections TodoSection[]
  todoAssignees TodoAssignee[]
  folders      Folder[]
  files        File[]
  fileVersions FileVersion[]
  documents    Document[]
  events       Event[]
  eventInvitees EventInvitee[]
  chatMessages ChatMessage[]
  uploadKeys    UploadKey[]
  notifications Notification[]
  activities    Activity[]
  subscriptions Subscription[]
  reactions     Reaction[]
  bookmarks     Bookmark[]
  notificationPreferences NotificationPreference[]
  hillSnapshots HillSnapshot[]
  checkinQuestions CheckinQuestion[]
  checkinRounds    CheckinRound[]
  checkinAnswers   CheckinAnswer[]
  cardColumns      CardColumn[]
  cards            Card[]
  projects         Project[]
}

model Membership {
  id          String   @id @default(cuid())
  userId      String
  workspaceId String
  role        Role     @default(MEMBER)
  createdAt   DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Invitation {
  id          String    @id @default(cuid())
  workspaceId String
  // null for link invites (anyone holding the link may join).
  email       String?
  role        Role      @default(MEMBER)
  // Only the SHA-256 hash of the invite token is stored; the raw token lives in the link.
  tokenHash   String    @unique
  invitedById String
  // null = never expires (link invites; revoke them to stop them).
  expiresAt   DateTime?
  // Link invites are reusable: they are never marked accepted, joins are counted instead.
  reusable    Boolean   @default(false)
  useCount    Int       @default(0)
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

// ------------------------------------------------------- Message board ----

model Post {
  id          String   @id @default(cuid())
  workspaceId String
  authorId    String
  title       String
  body        String   @db.Text
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Soft delete: set while the row is in the trash (purged after 30 days by the cleanup cron).
  deletedAt   DateTime?
  deletedById String?
  // Draft: publishedAt is null (visible only to the author). Rows created without it count as published.
  publishedAt DateTime? @default(now())
  // Scheduled: publishedAt null + scheduledFor set = publishes automatically at that time (cron). Both null = plain draft.
  scheduledFor DateTime?
  categoryId  String?
  // Optional project (null = "Genel", workspace-level).
  projectId   String?
  // Team-only: hidden from GUEST members. false = visible to everyone (the default for all existing rows).
  internal    Boolean  @default(false)

  workspace Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  category  MessageCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  comments  Comment[]

  @@index([workspaceId, createdAt])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, categoryId])
  @@index([workspaceId, projectId])
  @@index([scheduledFor])
}

model MessageCategory {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  emoji       String
  position    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts     Post[]

  @@index([workspaceId])
}

model Comment {
  id          String   @id @default(cuid())
  workspaceId String
  // A comment belongs to exactly one subject (enforced by a CHECK constraint in the migration).
  postId      String?
  todoItemId  String?
  documentId  String?
  eventId     String?
  authorId    String
  body        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  post      Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  todoItem  TodoItem? @relation(fields: [todoItemId], references: [id], onDelete: Cascade)
  document  Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  event     Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([todoItemId, createdAt])
  @@index([documentId, createdAt])
  @@index([eventId, createdAt])
  @@index([workspaceId])
}

// -------------------------------------------------------------- To-dos ----

enum TodoStatus {
  OPEN
  DONE
}

model TodoList {
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  name        String
  description String?  @db.Text
  position    Int      @default(0)
  // Hill chart: 0-50 uphill (figuring it out), 50-100 downhill (making it happen).
  hillPosition Int     @default(0)
  hillNote     String? @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Soft delete: set while the row is in the trash (purged after 30 days by the cleanup cron).
  deletedAt   DateTime?
  deletedById String?
  // Optional project (null = "Genel", workspace-level).
  projectId   String?
  // Team-only: hidden from GUEST members. false = visible to everyone (the default for all existing rows).
  internal    Boolean  @default(false)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  items     TodoItem[]
  sections  TodoSection[]
  hillSnapshots HillSnapshot[]

  @@index([workspaceId, position])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, projectId])
}

model HillSnapshot {
  id          String   @id @default(cuid())
  workspaceId String
  listId      String
  position    Int
  note        String?  @db.Text
  createdById String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list      TodoList  @relation(fields: [listId], references: [id], onDelete: Cascade)

  @@index([workspaceId, listId])
}

model TodoItem {
  id          String     @id @default(cuid())
  workspaceId String
  listId      String
  createdById String
  assigneeId  String?
  title       String
  notes       String?    @db.Text
  status      TodoStatus @default(OPEN)
  dueDate     DateTime?  @db.Date
  startOn     DateTime?  @db.Date
  sectionId   String?
  completedAt DateTime?
  position    Int        @default(0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  // Soft delete: set while the row is in the trash (purged after 30 days by the cleanup cron).
  deletedAt   DateTime?
  deletedById String?
  // Reminder ("Hatırlatma"): null remindAt = none. reminderSentAt is stamped by the reminders cron.
  remindAt       DateTime?
  reminderSentAt DateTime?

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  section   TodoSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  extraAssignees TodoAssignee[]
  list      TodoList  @relation(fields: [listId], references: [id], onDelete: Cascade)
  createdBy User      @relation("TodoCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignee  User?     @relation("TodoAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments  Comment[]

  @@index([listId, position])
  @@index([workspaceId, status])
  @@index([assigneeId])
  @@index([workspaceId, deletedAt])
  @@index([sectionId])
  @@index([remindAt, reminderSentAt])
}

/// Optional named header inside a to-do list. Items with sectionId null render ungrouped.
model TodoSection {
  id          String   @id @default(cuid())
  workspaceId String
  listId      String
  name        String
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  list      TodoList   @relation(fields: [listId], references: [id], onDelete: Cascade)
  items     TodoItem[]

  @@index([workspaceId, listId])
}

/// Additional assignees of a to-do (TodoItem.assigneeId stays the primary one).
model TodoAssignee {
  id          String   @id @default(cuid())
  workspaceId String
  todoItemId  String
  userId      String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  todoItem  TodoItem  @relation(fields: [todoItemId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([todoItemId, userId])
  @@index([workspaceId, userId])
}

// ----------------------------------------------------- Files and docs ----

model Folder {
  id          String   @id @default(cuid())
  workspaceId String
  parentId    String?
  createdById String
  name        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Soft delete: set while the row is in the trash (purged after 30 days by the cleanup cron).
  deletedAt   DateTime?
  deletedById String?
  // Optional project (null = "Genel", workspace-level).
  projectId   String?
  // Team-only: hidden from GUEST members. false = visible to everyone (the default for all existing rows).
  internal    Boolean  @default(false)

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent    Folder?    @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Folder[]   @relation("FolderTree")
  createdBy User       @relation(fields: [createdById], references: [id], onDelete: Cascade)
  files     File[]
  documents Document[]

  @@index([workspaceId, parentId])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, projectId])
}

model File {
  id           String   @id @default(cuid())
  workspaceId  String
  folderId     String?
  uploadedById String
  name         String
  mimeType     String
  size         Int
  // Object key in the storage backend (R2 / local). Always prefixed with the workspaceId.
  storageKey   String   @unique
  // A photo attached to a chat message: kept out of the Files browser, recents and search.
  fromChat     Boolean  @default(false)
  createdAt    DateTime @default(now())
  // Soft delete: set while the row is in the trash (purged after 30 days by the cleanup cron).
  deletedAt   DateTime?
  deletedById String?
  // Who / when uploaded the CURRENT bytes (null = the original upload: uploadedById / createdAt).
  versionById String?
  versionAt   DateTime?

  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder      Folder?      @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy  User         @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  chatMessage ChatMessage?
  versions    FileVersion[]

  @@index([workspaceId, folderId])
  @@index([workspaceId, deletedAt])
}

// Older bytes of a File (the File row itself points at the current version).
model FileVersion {
  id           String   @id @default(cuid())
  workspaceId  String
  fileId       String
  storageKey   String   @unique
  size         Int
  mimeType     String
  uploadedById String
  version      Int
  // When these bytes were uploaded.
  createdAt    DateTime @default(now())

  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  file       File      @relation(fields: [fileId], references: [id], onDelete: Cascade)
  uploadedBy User      @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@unique([fileId, version])
  @@index([workspaceId, fileId])
}

model Document {
  id          String   @id @default(cuid())
  workspaceId String
  folderId    String?
  authorId    String
  title       String
  content     String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Soft delete: set while the row is in the trash (purged after 30 days by the cleanup cron).
  deletedAt   DateTime?
  deletedById String?
  // Team-only: hidden from GUEST members. false = visible to everyone (the default for all existing rows).
  internal    Boolean  @default(false)

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  folder    Folder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  Comment[]

  @@index([workspaceId, folderId])
  @@index([workspaceId, deletedAt])
}

// ------------------------------------------------------------ Calendar ----

model Event {
  id          String   @id @default(cuid())
  workspaceId String
  createdById String
  title       String
  description String?  @db.Text
  location    String?
  startsAt    DateTime
  endsAt      DateTime
  allDay      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  // Soft delete: set while the row is in the trash (purged after 30 days by the cleanup cron).
  deletedAt   DateTime?
  deletedById String?
  // Recurrence: NONE | DAILY | WEEKLY | MONTHLY. startsAt/endsAt describe the first occurrence;
  // recurrenceUntil (inclusive, end of an Istanbul day) caps the series, null = open-ended.
  recurrence      String    @default("NONE")
  recurrenceUntil DateTime?
  // Optional project (null = "Genel", workspace-level).
  projectId   String?
  // Team-only: hidden from GUEST members. false = visible to everyone (the default for all existing rows).
  internal    Boolean  @default(false)
  // Reminder ("Hatırlatma"): null remindAt = none. reminderSentAt is stamped by the reminders cron.
  remindAt       DateTime?
  reminderSentAt DateTime?

  workspace Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  createdBy User           @relation(fields: [createdById], references: [id], onDelete: Cascade)
  comments  Comment[]
  invitees  EventInvitee[]

  @@index([workspaceId, startsAt])
  @@index([workspaceId, deletedAt])
  @@index([workspaceId, projectId])
  @@index([remindAt, reminderSentAt])
}

model EventInvitee {
  id          String   @id @default(cuid())
  workspaceId String
  eventId     String
  userId      String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([workspaceId, userId])
}

// ---------------------------------------------------------------- Chat ----

model ChatMessage {
  id          String   @id @default(cuid())
  workspaceId String
  authorId    String
  body        String   @db.Text
  // Client-generated id; makes a retried send idempotent.
  clientId    String?
  // Optional photo (a File with fromChat = true); one photo per message.
  fileId      String?  @unique
  // null = the workspace's public room; otherwise a direct message to this member.
  recipientId String?
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author    User      @relation("ChatAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  recipient User?     @relation("ChatRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  file      File?     @relation(fields: [fileId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, authorId, clientId])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, recipientId, createdAt])
}

// Every storage key that has ever been turned into a File row. A key is single-use:
// completing an upload inserts here, so a deleted file cannot be brought back by
// replaying its upload token.
model UploadKey {
  storageKey  String   @id
  workspaceId String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

// ------------------------------------------------------- Notifications ----

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  // Recipient. Must be a member of workspaceId at creation time.
  userId      String
  actorId     String?
  // e.g. TODO_ASSIGNED, POST_CREATED, POST_COMMENT, EVENT_CREATED, MEMBER_JOINED
  type        String
  title       String
  body        String?   @db.Text
  // Workspace-relative path segment, e.g. "messages/<postId>". Never an absolute URL.
  path        String
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, workspaceId, readAt])
  @@index([userId, createdAt])
}

// A member following a post, to-do or event: gets its comment notifications.
// subjectType is "post" | "todo" | "event"; there is no FK to the subject
// (it is polymorphic), the service validates it inside the workspace.
model Subscription {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  subjectType String
  subjectId   String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectType, subjectId])
  @@index([workspaceId, subjectType, subjectId])
}

// Boosts: emoji reactions on posts and comments. subjectType is "post" |
// "comment"; polymorphic like Subscription (no FK), so the service validates
// the subject inside the workspace and deleteComment removes its reactions.
model Reaction {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  subjectType String
  subjectId   String
  emoji       String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectType, subjectId, emoji])
  @@index([workspaceId, subjectType, subjectId])
}

// ------------------------------------------------------ Email and tokens ----

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// Single-use tokens mailed to a user. Only the SHA-256 hash is stored.
model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// Every outgoing email is recorded here first. With MAIL_DRIVER=outbox (dev default)
// nothing is sent and the row is the delivery; with MAIL_DRIVER=smtp it is also sent.
model EmailOutbox {
  id        String    @id @default(cuid())
  to        String
  subject   String
  text      String    @db.Text
  html      String?   @db.Text
  // e.g. invite, verify-email, password-reset
  kind      String
  sentAt    DateTime?
  error     String?   @db.Text
  createdAt DateTime  @default(now())

  @@index([to, createdAt])
}

// ------------------------------------------------------------ Activity ----

// Append-only workspace activity feed.
model Activity {
  id          String   @id @default(cuid())
  workspaceId String
  actorId     String?
  // e.g. POST_CREATED, COMMENT_CREATED, TODO_COMPLETED, FILE_UPLOADED, EVENT_CREATED, MEMBER_JOINED
  type        String
  // Short human-readable subject, e.g. the post title.
  title       String
  // Workspace-relative path segment, e.g. "messages/<postId>". Never an absolute URL.
  path        String
  // What the row is about, e.g. ("post", <id>), so rows can be removed when the subject is deleted.
  subjectType String?
  subjectId   String?
  // Team-only: hidden from GUEST members. false = visible to everyone (the default for all existing rows).
  internal    Boolean  @default(false)
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([workspaceId, subjectType, subjectId])
}

// Bookmarks ("Yer imlerim"): a personal shortcut to a post, to-do, document or
// event. subjectType is "post" | "todo" | "document" | "event"; polymorphic
// like Subscription (no FK), so the service validates the subject inside the
// workspace and the list drops trashed / hidden-draft subjects.
model Bookmark {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  subjectType String
  subjectId   String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectType, subjectId])
  @@index([workspaceId, userId])
}

// Per-user, per-workspace notification preferences: the types the user muted.
// No row = everything on.
model NotificationPreference {
  id          String   @id @default(cuid())
  workspaceId String
  userId      String
  mutedTypes  String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

// Automatic check-ins: recurring questions posted on a schedule (Istanbul time).
model CheckinQuestion {
  id          String   @id @default(cuid())
  workspaceId String
  text        String
  // 0 = Sunday .. 6 = Saturday (Istanbul local weekday)
  weekdays    Int[]
  // 0-23, Istanbul local hour
  hour        Int
  active      Boolean  @default(true)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User            @relation(fields: [createdById], references: [id], onDelete: Cascade)
  rounds    CheckinRound[]

  @@index([workspaceId])
}

model CheckinRound {
  id          String   @id @default(cuid())
  workspaceId String
  questionId  String
  // YYYY-MM-DD in Istanbul
  dateKey     String
  createdAt   DateTime @default(now())

  workspace Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  question  CheckinQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answers   CheckinAnswer[]

  @@unique([questionId, dateKey])
  @@index([workspaceId, createdAt])
}

model CheckinAnswer {
  id          String   @id @default(cuid())
  workspaceId String
  roundId     String
  userId      String
  body        String   @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  round     CheckinRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roundId, userId])
  @@index([workspaceId])
}

// ------------------------------------------------------------ Card table ----

model CardColumn {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  position    Int      @default(0)
  createdById String
  createdAt   DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  cards     Card[]

  @@index([workspaceId])
}

model Card {
  id          String    @id @default(cuid())
  workspaceId String
  columnId    String
  title       String
  notes       String?   @db.Text
  assigneeId  String?
  dueOn       DateTime? @db.Date
  position    Int       @default(0)
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  // Soft delete: a deleted card is hidden everywhere.
  deletedAt   DateTime?
  deletedById String?

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  column    CardColumn @relation(fields: [columnId], references: [id], onDelete: Cascade)
  createdBy User       @relation("CardCreator", fields: [createdById], references: [id], onDelete: Cascade)
  assignee  User?      @relation("CardAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@index([workspaceId])
  @@index([workspaceId, columnId, deletedAt])
}

// ------------------------------------------------------------ Projects ----

model Project {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  description String?  @db.Text
  archived    Boolean  @default(false)
  position    Int      @default(0)
  // Template: a project marked as a template holds a structure-only skeleton in templateSpec
  // (to-do lists, folders, starter message titles). Never listed as a normal project.
  isTemplate   Boolean @default(false)
  templateSpec Json?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User       @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Cascade)
  posts     Post[]
  todoLists TodoList[]
  folders   Folder[]
  events    Event[]

  @@unique([workspaceId, slug])
  @@index([workspaceId])
}
