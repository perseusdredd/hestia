# --- Database -------------------------------------------------------------
# Local dev: `docker compose up -d` (see docker-compose.yml)
# Production (Neon):
#   DATABASE_URL = the POOLED string (host contains "-pooler"), with
#     ?sslmode=require&pgbouncer=true&connection_limit=5&pool_timeout=15&connect_timeout=15
#   DIRECT_URL   = the direct (non-pooler) string, ?sslmode=require; used by
#     `prisma migrate deploy`. Required in production.
DATABASE_URL="postgresql://hestia:hestia@127.0.0.1:5433/hestia?schema=public"
DIRECT_URL="postgresql://hestia:hestia@127.0.0.1:5433/hestia?schema=public"

# --- Auth.js v5 -----------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET=""
# Public origin of the app. Emailed links (verify, reset, invite) are built
# from it, never from request headers. REQUIRED in production (on Vercel
# VERCEL_PROJECT_PRODUCTION_URL is used when AUTH_URL is empty).
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"
# Optional Google OAuth. Leave empty to disable the Google button.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# --- Files (Cloudflare R2, S3 compatible) ---------------------------------
# STORAGE_DRIVER=local stores uploads under ./.storage (dev only).
# STORAGE_DRIVER=r2 uses the R2_* variables below.
# STORAGE_DRIVER=blob uses a PRIVATE Vercel Blob store (vercel blob create-store <name>
#   --access private); Vercel sets BLOB_READ_WRITE_TOKEN on the linked project.
STORAGE_DRIVER="local"
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Only for STORAGE_DRIVER=blob (set by the Vercel Blob integration):
BLOB_READ_WRITE_TOKEN=""
# Optional: directory for the local driver (default ./.storage).
LOCAL_STORAGE_DIR=""
# The local driver refuses to run in production unless this is "true".
# On Vercel use STORAGE_DRIVER="r2" instead (the filesystem is not persistent).
ALLOW_LOCAL_STORAGE=""
# Optional: HMAC secret for upload tokens (falls back to AUTH_SECRET).
UPLOAD_TOKEN_SECRET=""

# --- Realtime chat (Pusher Channels) --------------------------------------
# Leave empty to fall back to polling.
PUSHER_APP_ID=""
PUSHER_SECRET=""
NEXT_PUBLIC_PUSHER_KEY=""
NEXT_PUBLIC_PUSHER_CLUSTER="eu"

# --- Email ----------------------------------------------------------------
# Every mail is first written to the EmailOutbox table.
# MAIL_DRIVER="outbox" (default): nothing is sent; read mails at /dev/outbox.
# MAIL_DRIVER="smtp": the row is then delivered via the SMTP_* server below.
MAIL_DRIVER="outbox"
SMTP_HOST=""
# 587 (STARTTLS, default) or 465 (implicit TLS).
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Sender shown to recipients.
MAIL_FROM="Hestia <no-reply@example.com>"
# /dev/outbox (a signed-in user's own mails) is always on outside production.
# Set to "true" to enable it on a production build too (local smoke/e2e only;
# never on a public deployment).
ENABLE_DEV_OUTBOX=""

# --- Scheduled cleanup (Vercel Cron) --------------------------------------
# Bearer secret for GET /api/cron/cleanup (vercel.json runs it daily at 03:00
# UTC). At least 16 characters, e.g. `openssl rand -base64 32`. Without it the
# route answers 503 and nothing is cleaned up.
CRON_SECRET=""
